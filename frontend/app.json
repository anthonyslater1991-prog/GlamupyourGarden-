{
  "expo": {
    "name": "Glam up your Garden",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.outdooruplift.nn0nql",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of your garden to redesign it",
        "NSPhotoLibraryUsageDescription": "Upload garden photos to start a project"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2E5C42"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.outdooruplift.nn0nql",
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Glam up your Garden",
      "shortName": "Glam Garden",
      "themeColor": "#4A7C59",
      "backgroundColor": "#F5F8F2",
      "display": "standalone",
      "startUrl": "/",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-camera",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}